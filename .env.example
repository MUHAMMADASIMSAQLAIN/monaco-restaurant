# ==============================================================================
# MONACO RESTAURANT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Private Zapier Catch Hook Webhook URL
# DO NOT expose this in frontend React code (no VITE_ prefix!)
# Obtain this URL from your Zapier automation trigger: "Webhooks by Zapier" -> "Catch Hook"
ZAPIER_RESERVATION_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXX/YYYYYY/

# Server Environment
NODE_ENV=production

# Restaurant Operational Email Notifications (Optional fallback)
RESTAURANT_OWNER_EMAIL=owner@monaco-restaurant.com
RESTAURANT_CONTACT_PHONE=+37798062000
